[Unit]
Description=Rebuild Goodix GXFP51A0 fingerprint context after resume
Documentation=https://github.com/GodsQuantum/huawei-matebook-13-linux
After=fprintd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/gxfp51a0-resume-prewarm
TimeoutStartSec=50s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
