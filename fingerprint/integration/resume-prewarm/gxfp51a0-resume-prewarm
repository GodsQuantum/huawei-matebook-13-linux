#!/usr/bin/env bash
set -Eeuo pipefail

TAG="gxfp51a0-resume-prewarm"
log_info() { logger -t "$TAG" -- "$*"; }

found=0
for modalias in /sys/bus/spi/devices/*/modalias; do
  [[ -r "$modalias" ]] || continue
  if grep -q 'GXFP51A0' "$modalias"; then
    found=1
    break
  fi
done
(( found )) || exit 0

systemctl --quiet is-active fprintd.service || exit 0

raw="$(busctl --system call   net.reactivated.Fprint   /net/reactivated/Fprint/Manager   net.reactivated.Fprint.Manager   GetDefaultDevice 2>/dev/null || true)"
device="$(sed -n 's/^o "\(.*\)"$/\1/p' <<<"$raw")"
[[ -n "$device" ]] || {
  log_info "post-resume prewarm skipped: no default fprintd device"
  exit 0
}

if timeout 50s busctl --system --timeout=45s call   net.reactivated.Fprint   "$device"   net.reactivated.Fprint.Device   Claim s "" >/dev/null 2>&1; then
  log_info "post-resume fprintd Claim completed; sensor context prewarmed"
  exit 0
fi

log_info "post-resume prewarm failed or busy; Claim-time recovery remains active"
exit 1
