#!/usr/bin/env bash
set -Eeuo pipefail

TAG="gxfp51a0-boot-prewarm"
log_info() { logger -t "$TAG" -- "$*"; }

found=0
for modalias in /sys/bus/spi/devices/*/modalias; do
  [[ -r "$modalias" ]] || continue
  if grep -q 'GXFP51A0' "$modalias"; then found=1; break; fi
done
(( found )) || exit 0

systemctl --quiet is-active fprintd.service || {
  log_info "boot prewarm skipped: fprintd is not active"
  exit 0
}

device=""
for _ in $(seq 1 50); do
  raw="$(busctl --system call net.reactivated.Fprint     /net/reactivated/Fprint/Manager net.reactivated.Fprint.Manager     GetDefaultDevice 2>/dev/null || true)"
  device="$(sed -n 's/^o "\(.*\)"$/\1/p' <<<"$raw")"
  [[ -n "$device" ]] && break
  sleep 0.1
done

[[ -n "$device" ]] || {
  log_info "boot prewarm skipped: no default fprintd device after 5s"
  exit 0
}

if timeout 45s busctl --system call net.reactivated.Fprint "$device"   net.reactivated.Fprint.Device Claim s "" >/dev/null 2>&1; then
  log_info "cold-boot fprintd Claim completed; sensor ready before display manager"
else
  log_info "cold-boot prewarm failed or device busy; continuing to login safely"
fi
exit 0
