#!/usr/bin/env bash
set -Eeuo pipefail

TARGET="${GXFP51A0_KDE_LOCKSCREEN_QML:-/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/LockScreenUi.qml}"
V9_MARKER="GXFP51A0 native-S3-continuity fingerprint integration v9"
V8_MARKER="GXFP51A0 upstream-suspend-safe fingerprint integration v8"
V7_MARKER="GXFP51A0 resume-delay-aware fingerprint integration v7"
V6_MARKER="GXFP51A0 parallel-start fingerprint integration v6"
V5_MARKER="GXFP51A0 window-ready fingerprint integration v5"
V4_MARKER="GXFP51A0 window-ready fingerprint integration v4"
V3_MARKER="GXFP51A0 window-ready fingerprint integration v3"
V2_MARKER="GXFP51A0 instant fingerprint integration v2"
V1_MARKER="GXFP51A0 instant fingerprint integration: arm PAM immediately"
START_BEGIN="// GXFP51A0 window-ready startup timer BEGIN"
START_END="// GXFP51A0 window-ready startup timer END"
RESUME_BEGIN="// GXFP51A0 resume rearm BEGIN"
RESUME_END="// GXFP51A0 resume rearm END"
HB_BEGIN="// GXFP51A0 upstream fingerprint heartbeat backport BEGIN"
HB_END="// GXFP51A0 upstream fingerprint heartbeat backport END"
mode="${1:---apply}"

[[ -f "$TARGET" ]] || exit 0
grep -Fq 'id: lockScreenRoot' "$TARGET" || exit 0
grep -Fq 'authenticator.startAuthenticating();' "$TARGET" || exit 0
grep -Fq 'onUiVisibleChanged:' "$TARGET" || exit 0

rewrite_v1_to_stock() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    $0 == "        Component.onCompleted: {" { hold=$0; next }
    hold != "" && $0 == "            launchAnimation.start();" { hold=hold "\n" $0; next }
    hold != "" && $0 ~ /GXFP51A0 instant fingerprint integration: arm PAM immediately/ { hold=hold "\n" $0; old=1; next }
    hold != "" && old && $0 ~ /while keeping the lock-screen UI visually idle/ { hold=hold "\n" $0; next }
    hold != "" && old && $0 == "            authenticator.startAuthenticating();" { hold=hold "\n" $0; next }
    hold != "" && old && $0 == "        }" {
      print "        Component.onCompleted: launchAnimation.start();"
      hold=""; old=0; next
    }
    hold != "" { print hold; hold=""; old=0 }
    { print }
    END { if (hold != "") print hold }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v2_to_stock() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    $0 == "        Component.onCompleted: {" { hold=$0; next }
    hold != "" && $0 == "            launchAnimation.start();" { hold=hold "\n" $0; next }
    hold != "" && $0 ~ /GXFP51A0 instant fingerprint integration v2/ { hold=hold "\n" $0; mark=1; next }
    hold != "" && mark && $0 ~ /onUiVisibleChanged starts PAM/ { hold=hold "\n" $0; next }
    hold != "" && mark && $0 == "            uiVisible = true;" { hold=hold "\n" $0; next }
    hold != "" && mark && $0 == "        }" {
      print "        Component.onCompleted: launchAnimation.start();"
      hold=""; mark=0; next
    }
    hold != "" { print hold; hold=""; mark=0 }
    { print }
    END { if (hold != "") print hold }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_modern_to_stock() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 window-ready startup timer BEGIN/ { startup=1; next }
    startup && /\/\/ GXFP51A0 window-ready startup timer END/ { startup=0; next }
    /\/\/ GXFP51A0 resume rearm BEGIN/ { resume=1; next }
    resume && /\/\/ GXFP51A0 resume rearm END/ { resume=0; next }
    /\/\/ GXFP51A0 upstream fingerprint heartbeat backport BEGIN/ { hb=1; next }
    hb && /\/\/ GXFP51A0 upstream fingerprint heartbeat backport END/ { hb=0; next }
    startup || resume || hb { next }

    $0 == "        Component.onCompleted: {" { hold=$0; next }
    hold != "" && $0 == "            launchAnimation.start();" { hold=hold "\n" $0; next }
    hold != "" && $0 ~ /GXFP51A0 (window-ready fingerprint integration v[345]|parallel-start fingerprint integration v6|resume-delay-aware fingerprint integration v7|upstream-suspend-safe fingerprint integration v8|native-S3-continuity fingerprint integration v9)/ { hold=hold "\n" $0; mark=1; next }
    hold != "" && mark && $0 == "            authenticator.startAuthenticating();" { hold=hold "\n" $0; next }
    hold != "" && mark && $0 == "            gxfp51a0StartupAuthTimer.start();" { hold=hold "\n" $0; next }
    hold != "" && mark && $0 == "        }" {
      print "        Component.onCompleted: launchAnimation.start();"
      hold=""; mark=0; next
    }
    hold != "" { print hold; hold=""; mark=0 }
    { print }
    END { if (hold != "") print hold }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v3_to_v4() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 upstream fingerprint heartbeat backport BEGIN/ { hb=1; next }
    hb && /\/\/ GXFP51A0 upstream fingerprint heartbeat backport END/ { hb=0; next }
    hb { next }
    {
      gsub(/GXFP51A0 window-ready fingerprint integration v3/,
           "GXFP51A0 window-ready fingerprint integration v4")
      print
    }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v4_to_v5() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    $0 == "        onBlockUIChanged: {" && !inserted {
      print "        // GXFP51A0 resume rearm BEGIN"
      print "        property bool gxfp51a0ResumeRearmPending: false"
      print "        Connections {"
      print "            target: sessionManagement"
      print "            function onResumingFromSuspend() {"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = true;"
      print "                // If PAM is already idle this starts immediately. If the"
      print "                // pre-suspend password conversation is still unwinding,"
      print "                // startAuthenticating() is a no-op and onStateChanged below"
      print "                // retries exactly once when the old backend reaches Idle."
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        Connections {"
      print "            target: authenticator"
      print "            function onStateChanged() {"
      print "                if (!lockScreenRoot.gxfp51a0ResumeRearmPending) {"
      print "                    return;"
      print "                }"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = false;"
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        // GXFP51A0 resume rearm END"
      inserted=1
    }
    {
      gsub(/GXFP51A0 window-ready fingerprint integration v4/,
           "GXFP51A0 window-ready fingerprint integration v5")
      print
    }
    END {
      if (!inserted)
        exit 42
    }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v5 resume rearm applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v5_to_v6() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    $0 ~ /GXFP51A0 window-ready fingerprint integration v5/ && !done {
      sub(/GXFP51A0 window-ready fingerprint integration v5/,
          "GXFP51A0 parallel-start fingerprint integration v6")
      print
      print "            authenticator.startAuthenticating();"
      done=1
      next
    }
    { print }
    END {
      if (!done)
        exit 42
    }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v6 parallel auth applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v6_to_v7() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 resume rearm BEGIN/ && !done {
      print "        // GXFP51A0 resume rearm BEGIN"
      print "        property bool gxfp51a0ResumeRearmPending: false"
      print "        property bool gxfp51a0ResumeDelayActive: false"
      print "        Timer {"
      print "            id: gxfp51a0ResumeRearmTimer"
      print "            interval: 100"
      print "            repeat: false"
      print "            property int polls: 0"
      print "            onTriggered: {"
      print "                if (!lockScreenRoot.gxfp51a0ResumeRearmPending) {"
      print "                    return;"
      print "                }"
      print "                if (lockScreenRoot.gxfp51a0ResumeDelayActive) {"
      print "                    lockScreenRoot.gxfp51a0ResumeDelayActive = false;"
      print "                }"
      print "                if (authenticator.state === 0) {"
      print "                    lockScreenRoot.gxfp51a0ResumeRearmPending = false;"
      print "                    authenticator.startAuthenticating();"
      print "                    return;"
      print "                }"
      print "                polls++;"
      print "                if (polls < 50) {"
      print "                    interval = 100;"
      print "                    restart();"
      print "                }"
      print "            }"
      print "        }"
      print "        Connections {"
      print "            target: sessionManagement"
      print "            function onResumingFromSuspend() {"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = true;"
      print "                lockScreenRoot.gxfp51a0ResumeDelayActive = false;"
      print "                gxfp51a0ResumeRearmTimer.polls = 0;"
      print "                gxfp51a0ResumeRearmTimer.interval = 100;"
      print "                gxfp51a0ResumeRearmTimer.restart();"
      print "            }"
      print "        }"
      print "        Connections {"
      print "            target: authenticator"
      print "            function onStateChanged() {"
      print "                if (lockScreenRoot.gxfp51a0ResumeRearmPending"
      print "                    && !lockScreenRoot.gxfp51a0ResumeDelayActive) {"
      print "                    gxfp51a0ResumeRearmTimer.interval = 50;"
      print "                    gxfp51a0ResumeRearmTimer.restart();"
      print "                }"
      print "            }"
      print "            function onLoginFailedDelayStarted(what, source, uSecDelay) {"
      print "                if (!lockScreenRoot.gxfp51a0ResumeRearmPending || what !== 0) {"
      print "                    return;"
      print "                }"
      print "                lockScreenRoot.gxfp51a0ResumeDelayActive = true;"
      print "                gxfp51a0ResumeRearmTimer.interval = Math.max(100, Math.ceil(uSecDelay / 1000) + 50);"
      print "                gxfp51a0ResumeRearmTimer.restart();"
      print "            }"
      print "        }"
      print "        // GXFP51A0 resume rearm END"
      skip=1; done=1; next
    }
    skip && /\/\/ GXFP51A0 resume rearm END/ { skip=0; next }
    skip { next }
    {
      gsub(/GXFP51A0 parallel-start fingerprint integration v6/,
           "GXFP51A0 resume-delay-aware fingerprint integration v7")
      print
    }
    END { if (!done) exit 42 }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v7 resume rearm applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

rewrite_v7_to_v8() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 resume rearm BEGIN/ { resume=1; next }
    resume && /\/\/ GXFP51A0 resume rearm END/ { resume=0; next }
    resume { next }
    {
      gsub(/GXFP51A0 resume-delay-aware fingerprint integration v7/,
           "GXFP51A0 upstream-suspend-safe fingerprint integration v8")
      print
    }
  ' "$TARGET" > "$tmp"
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

apply_v7() {
  local tmp

  grep -Fq "$V7_MARKER" "$TARGET" && return 0
  if grep -Fq "$V6_MARKER" "$TARGET"; then
    rewrite_v6_to_v7
    return 0
  fi
  if grep -Fq "$V5_MARKER" "$TARGET"; then
    rewrite_v5_to_v6
    rewrite_v6_to_v7
    return 0
  fi
  if grep -Fq "$V4_MARKER" "$TARGET"; then
    rewrite_v4_to_v5
    rewrite_v5_to_v6
    rewrite_v6_to_v7
    return 0
  fi
  if grep -Fq "$V3_MARKER" "$TARGET"; then
    rewrite_v3_to_v4
    rewrite_v4_to_v5
    rewrite_v5_to_v6
    rewrite_v6_to_v7
    return 0
  fi
  grep -Fq "$V1_MARKER" "$TARGET" && rewrite_v1_to_stock
  grep -Fq "$V2_MARKER" "$TARGET" && rewrite_v2_to_stock

  tmp="$(mktemp "${TARGET}.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN

  awk '
    $0 == "        onBlockUIChanged: {" && !inserted {
      print "        // GXFP51A0 window-ready startup timer BEGIN"
      print "        Timer {"
      print "            id: gxfp51a0StartupAuthTimer"
      print "            interval: 25"
      print "            repeat: true"
      print "            triggeredOnStart: true"
      print "            property int attempts: 0"
      print "            onTriggered: {"
      print "                attempts++;"
      print "                if (lockScreenRoot.Window.window) {"
      print "                    stop();"
      print "                    lockScreenRoot.uiVisible = true;"
      print "                } else if (attempts >= 80) {"
      print "                    stop();"
      print "                    console.warn(\"GXFP51A0: lockscreen Window not ready for fingerprint startup\");"
      print "                }"
      print "            }"
      print "            onRunningChanged: {"
      print "                if (running) {"
      print "                    attempts = 0;"
      print "                }"
      print "            }"
      print "        }"
      print "        // GXFP51A0 window-ready startup timer END"
      print "        // GXFP51A0 resume rearm BEGIN"
      print "        property bool gxfp51a0ResumeRearmPending: false"
      print "        Connections {"
      print "            target: sessionManagement"
      print "            function onResumingFromSuspend() {"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = true;"
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        Connections {"
      print "            target: authenticator"
      print "            function onStateChanged() {"
      print "                if (!lockScreenRoot.gxfp51a0ResumeRearmPending) {"
      print "                    return;"
      print "                }"
      print "                lockScreenRoot.gxfp51a0ResumeRearmPending = false;"
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        // GXFP51A0 resume rearm END"
      inserted=1
    }

    $0 == "        Component.onCompleted: launchAnimation.start();" {
      print "        Component.onCompleted: {"
      print "            launchAnimation.start();"
      print "            // GXFP51A0 parallel-start fingerprint integration v6"
      print "            authenticator.startAuthenticating();"
      print "            gxfp51a0StartupAuthTimer.start();"
      print "        }"
      completed=1
      next
    }

    { print }
    END {
      if (!inserted || !completed)
        exit 42
    }
  ' "$TARGET" > "$tmp" || {
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v6 lockscreen patch applied" >&2
    return 42
  }

  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
  trap - RETURN
  rewrite_v6_to_v7
}

apply_v8() {
  grep -Fq "$V8_MARKER" "$TARGET" && return 0

  if grep -Fq "$V7_MARKER" "$TARGET"; then
    rewrite_v7_to_v8
    return 0
  fi

  # Reuse the fully tested historical migration chain, then remove the resume
  # workaround now that KScreenLocker itself carries upstream MR !340.
  apply_v7
  rewrite_v7_to_v8
}

rewrite_v8_to_v9() {
  local tmp
  tmp="$(mktemp "${TARGET}.XXXXXX")"
  awk '
    /\/\/ GXFP51A0 window-ready startup timer END/ && !kick {
      print
      print "        // GXFP51A0 resume rearm BEGIN"
      print "        Connections {"
      print "            target: sessionManagement"
      print "            function onResumingFromSuspend() {"
      print "                // If authentication was already running, this is a no-op."
      print "                // If the greeter reached S3 before startup auth began, this"
      print "                // starts password + fingerprint immediately on resume."
      print "                gxfp51a0StartupAuthTimer.restart();"
      print "                authenticator.startAuthenticating();"
      print "            }"
      print "        }"
      print "        // GXFP51A0 resume rearm END"
      kick=1
      next
    }
    /GXFP51A0 upstream-suspend-safe fingerprint integration v8/ && !done {
      sub(/GXFP51A0 upstream-suspend-safe fingerprint integration v8/,
          "GXFP51A0 native-S3-continuity fingerprint integration v9")
      print
      getline
      if ($0 != "            authenticator.startAuthenticating();") {
        print
      }
      done=1
      next
    }
    { print }
    END { if (!kick || !done) exit 42 }
  ' "$TARGET" > "$tmp" || {
    rm -f "$tmp"
    echo "GXFP51A0: unsupported KDE LockScreenUi.qml; no v9 migration applied" >&2
    return 42
  }
  chmod --reference="$TARGET" "$tmp"
  chown --reference="$TARGET" "$tmp"
  mv -f "$tmp" "$TARGET"
}

apply_v9() {
  grep -Fq "$V9_MARKER" "$TARGET" && return 0
  if ! grep -Fq "$V8_MARKER" "$TARGET"; then
    apply_v8
  fi
  rewrite_v8_to_v9
}

case "$mode" in
  --apply)
    apply_v9
    ;;
  --remove)
    grep -Fq "$V1_MARKER" "$TARGET" && rewrite_v1_to_stock
    grep -Fq "$V2_MARKER" "$TARGET" && rewrite_v2_to_stock
    if grep -Fq "$V3_MARKER" "$TARGET" || grep -Fq "$V4_MARKER" "$TARGET" || grep -Fq "$V5_MARKER" "$TARGET" || grep -Fq "$V6_MARKER" "$TARGET" || grep -Fq "$V7_MARKER" "$TARGET" || grep -Fq "$V8_MARKER" "$TARGET" || grep -Fq "$V9_MARKER" "$TARGET"; then
      rewrite_modern_to_stock
    fi
    ;;
  --check)
    grep -Fq "$V9_MARKER" "$TARGET"
    grep -Fq 'id: gxfp51a0StartupAuthTimer' "$TARGET"
    grep -Fq 'if (lockScreenRoot.Window.window)' "$TARGET"
    grep -Fq 'gxfp51a0StartupAuthTimer.start();' "$TARGET"
    grep -A4 -F 'GXFP51A0 native-S3-continuity fingerprint integration v9' "$TARGET" | grep -Fq 'gxfp51a0StartupAuthTimer.start();'
    ! grep -A4 -F 'GXFP51A0 native-S3-continuity fingerprint integration v9' "$TARGET" | grep -Fq 'authenticator.startAuthenticating();'
    grep -Fq 'Window.window.requestActivate();' "$TARGET"
    grep -Fq 'function onResumingFromSuspend()' "$TARGET"
    grep -A8 -F 'function onResumingFromSuspend()' "$TARGET" | grep -Fq 'authenticator.startAuthenticating();'
    grep -A8 -F 'function onResumingFromSuspend()' "$TARGET" | grep -Fq 'gxfp51a0StartupAuthTimer.restart();'
    ! grep -Fq 'gxfp51a0ResumeRearmPending' "$TARGET"
    ! grep -Fq 'gxfp51a0ResumeRearmTimer' "$TARGET"
    ! grep -Fq 'onLoginFailedDelayStarted' "$TARGET"
    ! grep -Fq 'GXFP51A0 upstream fingerprint heartbeat backport BEGIN' "$TARGET"
    ;;
  *)
    echo "usage: $0 [--apply|--remove|--check]" >&2
    exit 2
    ;;
esac
