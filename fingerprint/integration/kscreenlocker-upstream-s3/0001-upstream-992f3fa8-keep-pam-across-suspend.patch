+void PamWorker::resetUnavailable()
+{
+    if (!m_unavailable) {
+        return;
+    }
+
+    m_unavailable = false;
+    // PAM_AUTHINFO_UNAVAIL is a hardware-availability result, not a wrong
+    // credential. A resume is a new availability boundary, so do not carry
+    // the old transaction's fail-delay into this fresh fingerprint attempt.
+    m_nextAttemptAllowedTime = std::chrono::steady_clock::now();
+    Q_EMIT unavailabilityChanged(m_unavailable);
+}
