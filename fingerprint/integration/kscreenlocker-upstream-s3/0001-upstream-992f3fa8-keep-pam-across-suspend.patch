+void PamAuthenticator::runPendingRestart()
+{
+    if (!m_restartPending || m_inAuthentication || m_restartDelayActive) {
+        return;
+    }
+
+    m_restartPending = false;
+    m_restartFromUnavailable = false;
+    m_unlocked = false;
+
+    PamWorker *worker = d;
+    QMetaObject::invokeMethod(worker, [worker] {
+        // PAM_AUTHINFO_UNAVAIL is sticky in PamWorker by design. A resume is a
+        // new hardware-availability boundary, so clear that latch and its
+        // inherited fail-delay before starting a fresh noninteractive attempt.
+        worker->resetUnavailable();
+        worker->authenticate();
+    });
+}
+
+void PamAuthenticator::restartAuthentication()
+{
+    m_unlocked = false;
+    m_restartPending = true;
+    m_restartFromUnavailable = m_unavailable;
+
+    qCInfo(KSCREENLOCKER_GREET) << "Restarting PAM authenticator after resume" << qUtf8Printable(m_service)
+                                << "active=" << m_inAuthentication << "unavailable=" << m_unavailable;
+
+    if (m_inAuthentication) {
+        // Cancel only this authenticator. For fingerprint this exits a stale
+        // pam_fprintd conversation; the interactive password PAM is untouched.
+        cancel();
+        return;
+    }
+
+    runPendingRestart();
+}
