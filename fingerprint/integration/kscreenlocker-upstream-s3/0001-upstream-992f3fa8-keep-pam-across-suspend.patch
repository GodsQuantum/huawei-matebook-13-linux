diff -U0 -r a/greeter/greeterapp.cpp b/greeter/greeterapp.cpp
--- a/greeter/greeterapp.cpp	2026-09-08 12:53:02.000000000 +0200
+++ b/greeter/greeterapp.cpp	2026-09-28 01:24:51.612533842 +0200
@@ -145,2 +145,12 @@
-    connect(m_logindIntegration, &LogindIntegration::prepareForSleep, m_authenticators, [this] {
-        m_authenticators->cancel();
+    connect(m_logindIntegration, &LogindIntegration::prepareForSleep, m_authenticators, [this](bool sleeping) {
+        if (sleeping) {
+            // KDE MR !340 semantics: suspend is not an authentication failure.
+            // Keep the password PAM conversation parked instead of cancelling it.
+            return;
+        }
+
+        // A greeter may be created just before S3, before QML starts auth. Or
+        // libfprint may stop only the fingerprint worker while password stays
+        // active. Handle both cases without restarting/cancelling password.
+        qCInfo(KSCREENLOCKER_GREET) << "Resume: rearming missing authenticators";
+        m_authenticators->resumeAuthenticating();
diff -U0 -r a/greeter/pamauthenticators.cpp b/greeter/pamauthenticators.cpp
--- a/greeter/pamauthenticators.cpp	2026-09-08 12:53:02.000000000 +0200
+++ b/greeter/pamauthenticators.cpp	2026-09-28 01:24:51.612321555 +0200
@@ -155,0 +156,18 @@
+void PamAuthenticators::resumeAuthenticating()
+{
+    if (d->graceLocked) {
+        return;
+    }
+
+    if (d->state == AuthenticatorsState::Idle) {
+        qCDebug(KSCREENLOCKER_GREET) << "PamAuthenticators: resume from idle; starting all authenticators";
+        startAuthenticating();
+        return;
+    }
+
+    qCDebug(KSCREENLOCKER_GREET) << "PamAuthenticators: resume while active; re-kicking noninteractive authenticators";
+    for (auto &&noninteractive : d->noninteractive) {
+        noninteractive->tryUnlock();
+    }
+}
+
diff -U0 -r a/greeter/pamauthenticators.h b/greeter/pamauthenticators.h
--- a/greeter/pamauthenticators.h	2026-09-08 12:53:02.000000000 +0200
+++ b/greeter/pamauthenticators.h	2026-09-28 01:24:51.612156475 +0200
@@ -52,0 +53,6 @@
+    // Resume boundary: if the group never started, start password + all
+    // noninteractive authenticators. If password is already running, only
+    // re-kick noninteractive workers; PamWorker::authenticate() is itself
+    // idempotent while a worker is still inside pam_authenticate().
+    void resumeAuthenticating();
+
