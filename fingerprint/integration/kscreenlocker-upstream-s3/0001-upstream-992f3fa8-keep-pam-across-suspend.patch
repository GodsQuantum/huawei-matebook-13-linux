+void PamAuthenticators::resumeAuthenticating()
+{
+    if (d->graceLocked) {
+        return;
+    }
+
+    if (d->state == AuthenticatorsState::Idle) {
+        qCInfo(KSCREENLOCKER_GREET) << "Resume: authenticator group idle; starting all authenticators";
+        startAuthenticating();
+        return;
+    }
+
+    qCInfo(KSCREENLOCKER_GREET) << "Resume: restarting noninteractive authenticators while preserving password";
+    for (auto &&noninteractive : d->noninteractive) {
+        noninteractive->restartAuthentication();
+    }
+}
