# Based on Arch Linux kscreenlocker 6.7.5 packaging.
# Local delta: KDE MR !340 semantics + robust fingerprint-only resume restart.

pkgname=kscreenlocker
pkgver=6.7.5
_dirver=$(echo $pkgver | cut -d. -f1-3)
pkgrel=1.5
pkgdesc='Library and components for secure lock screen architecture'
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=(LGPL-2.0-or-later)
depends=(glibc
         kcmutils
         kconfig
         kcoreaddons
         kcrash
         kdeclarative
         kglobalaccel
         ki18n
         kidletime
         kio
         kirigami
         knotifications
         kpackage
         ksvg
         kwindowsystem
         kxmlgui
         layer-shell-qt
         libkscreen
         libstdc++
         libx11
         libxcb
         libxi
         pam
         libplasma
         qt6-base
         qt6-declarative
         wayland
         xcb-util-keysyms)
makedepends=(extra-cmake-modules
             kdoctools)
groups=(plasma)
source=(https://download.kde.org/stable/plasma/$_dirver/$pkgname-$pkgver.tar.xz{,.sig}
        0001-upstream-992f3fa8-keep-pam-across-suspend.patch
        kde.pam
        kde-fingerprint.pam
        kde-smartcard.pam)
sha256sums=('6c41ce2cb79d2b85d4fbe5a3a61c09e40c70e5a869ae6f0352c7e1cb3b44606b'
            'SKIP'
            'e85ff3e9e2b4a6da8454e787f6b4592534c3e68000d504556ad87f5ad814ce4b'
            'adba7bb7c27eb3a572e5e9d3cea0dbeebe59d3634472d1863d14fe892cb13b2b'
            '32734b4e1ec8b7f7e32b6cb2d68285c5c4f15f53736bba085096e76095181241'
            '5d9c31cbf66e8e455b9559c929f184efd598f714743d5a1e6ce20adb44dc4b2d')
validpgpkeys=('E0A3EB202F8E57528E13E72FD7574483BB57B18D'
              '0AAC775BB6437A8D9AF7A3ACFE0784117FBCE11D'
              'D07BD8662C56CB291B316EB2F5675605C74E02CF'
              '1FA881591C26B276D7A5518EEAAF29B42A678C20')

prepare() {
  cd "$pkgname-$pkgver"
  patch -Np1 -i "$srcdir/0001-upstream-992f3fa8-keep-pam-across-suspend.patch"

  # Suspend must never cancel password PAM. Resume robustly restarts only
  # noninteractive workers.
  ! grep -Fq 'm_authenticators->cancel();' greeter/greeterapp.cpp
  grep -Fq 'if (sleeping)' greeter/greeterapp.cpp
  grep -Fq 'Resume: rearming fingerprint PAM' greeter/greeterapp.cpp
  grep -Fq 'm_authenticators->resumeAuthenticating();' greeter/greeterapp.cpp

  grep -Fq 'void PamAuthenticators::resumeAuthenticating()' greeter/pamauthenticators.cpp
  grep -Fq 'if (d->state == AuthenticatorsState::Idle)' greeter/pamauthenticators.cpp
  grep -Fq 'noninteractive->restartAuthentication();' greeter/pamauthenticators.cpp
  ! sed -n '/void PamAuthenticators::resumeAuthenticating()/,/^}/p' greeter/pamauthenticators.cpp | grep -Fq 'd->interactive->cancel'

  grep -Fq 'void PamAuthenticator::restartAuthentication()' greeter/pamauthenticator.cpp
  grep -Fq 'void PamAuthenticator::runPendingRestart()' greeter/pamauthenticator.cpp
  grep -Fq 'worker->resetUnavailable();' greeter/pamauthenticator.cpp
  grep -Fq 'worker->authenticate();' greeter/pamauthenticator.cpp
  grep -Fq 'm_restartDelayActive' greeter/pamauthenticator.cpp
  grep -Fq 'm_restartFromUnavailable' greeter/pamauthenticator.cpp
  grep -Fq 'ignoring stale fail-delay from unavailable noninteractive PAM' greeter/pamauthenticator.cpp
  grep -Fq 'm_nextAttemptAllowedTime = std::chrono::steady_clock::now();' greeter/pamauthenticator.cpp
  grep -Fq 'QTimer::singleShot' greeter/pamauthenticator.cpp
  grep -Fq 'void restartAuthentication();' greeter/pamauthenticator.h
}

build() {
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_INSTALL_LIBEXECDIR=/usr/lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$srcdir/kde.pam" "$pkgdir/usr/lib/pam.d/kde"
  install -Dm644 "$srcdir/kde-fingerprint.pam" "$pkgdir/usr/lib/pam.d/kde-fingerprint"
  install -Dm644 "$srcdir/kde-smartcard.pam" "$pkgdir/usr/lib/pam.d/kde-smartcard"
}
