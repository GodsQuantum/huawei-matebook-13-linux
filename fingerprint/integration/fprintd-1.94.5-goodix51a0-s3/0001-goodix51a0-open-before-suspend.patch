 static void
+suspend_after_open_cb (GObject      *source_obj,
+                       GAsyncResult *res,
+                       gpointer      user_data)
+{
+  g_autoptr(GTask) task = user_data;
+  FprintDevice *rdev = g_task_get_source_object (task);
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  GError *error = NULL;
+
+  if (!fp_device_open_finish (FP_DEVICE (source_obj), res, &error))
+    {
+      priv->opened_for_sleep = FALSE;
+      g_task_return_error (task, error);
+      return;
+    }
+
+  g_debug ("rel72: opened Goodix GXFP51A0 before suspend so the driver can park the MCU");
+  fp_device_suspend (priv->dev, NULL, suspend_cb, g_object_ref (task));
+}
+
+static void
+resume_close_cb (GObject      *source_obj,
+                 GAsyncResult *res,
+                 gpointer      user_data)
+{
+  g_autoptr(GTask) task = user_data;
+  FprintDevice *rdev = g_task_get_source_object (task);
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  GError *error = NULL;
+
+  if (!fp_device_close_finish (FP_DEVICE (source_obj), res, &error))
+    {
+      priv->opened_for_sleep = FALSE;
+      g_task_return_error (task, error);
+      return;
+    }
+
+  priv->opened_for_sleep = FALSE;
+  g_task_return_boolean (task, TRUE);
+}
