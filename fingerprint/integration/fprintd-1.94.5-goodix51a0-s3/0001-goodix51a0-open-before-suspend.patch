+      g_debug ("rel72: closing Goodix GXFP51A0 after resume to force a fresh Claim/Open");
+      fp_device_close (priv->dev, NULL, resume_close_cb, g_object_ref (task));
+      return;
+    }
+
+  g_task_return_boolean (task, TRUE);
 }
 
