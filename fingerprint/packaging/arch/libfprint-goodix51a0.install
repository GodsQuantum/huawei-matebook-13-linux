pre_remove() {
  systemctl disable --now gxfp51a0-boot-prewarm.service 2>/dev/null || true
  if [[ -x /usr/libexec/gxfp51a0-kde-lockscreen-integrate ]]; then
    /usr/libexec/gxfp51a0-kde-lockscreen-integrate --remove || true
  fi
}

post_install() {
  udevadm control --reload || true
  udevadm trigger --subsystem-match=spi || true
  udevadm settle --timeout=3 || true
  # rel37 removes the rel35/36 periodic synthetic Claim loop.
  systemctl stop gxfp51a0-warm-keepalive.timer gxfp51a0-warm-keepalive.service 2>/dev/null || true
  # rel42 replaces rel24-rel40 disk timing learning with session-local adaptation.
  # These files contain no biometric/secret material and are obsolete.
  rm -f /var/lib/fprint/.goodix51a0-timing         /var/lib/fprint/.goodix51a0-capture-timing
  systemctl daemon-reload || true
  # rel69: prime one warm production context once after boot/upgrade.
  # The close path intentionally keeps the validated TLS/background/FDT warm
  # context in RAM instead of forcing the experimental MCU 0x60 sleep on every
  # libfprint close. S3 remains a hard cold boundary in the driver itself.
  systemctl enable gxfp51a0-boot-prewarm.service >/dev/null 2>&1 || true
  systemctl restart fprintd.service || true
  systemctl start gxfp51a0-boot-prewarm.service || true
  if [[ -x /usr/libexec/gxfp51a0-kde-lockscreen-integrate ]]; then
    /usr/libexec/gxfp51a0-kde-lockscreen-integrate --apply || true
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  udevadm control --reload || true
  systemctl daemon-reload || true
  systemctl try-restart fprintd.service || true
}
