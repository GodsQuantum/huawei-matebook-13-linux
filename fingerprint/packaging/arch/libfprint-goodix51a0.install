pre_remove() {
  if [[ -x /usr/libexec/gxfp51a0-kde-lockscreen-integrate ]]; then
    /usr/libexec/gxfp51a0-kde-lockscreen-integrate --remove || true
  fi
}

post_install() {
  udevadm control --reload || true
  udevadm trigger --subsystem-match=spi || true
  udevadm settle --timeout=3 || true
  # rel37 removes the rel35/36 periodic synthetic Claim loop.
  systemctl stop gxfp51a0-warm-keepalive.timer gxfp51a0-warm-keepalive.service 2>/dev/null || true
  # rel41 replaces rel24-rel40 disk timing learning with session-local adaptation.
  # These files contain no biometric/secret material and are obsolete.
  rm -f /var/lib/fprint/.goodix51a0-timing         /var/lib/fprint/.goodix51a0-capture-timing
  systemctl daemon-reload || true
  systemctl restart --no-block fprintd.service || true
  if [[ -x /usr/libexec/gxfp51a0-kde-lockscreen-integrate ]]; then
    /usr/libexec/gxfp51a0-kde-lockscreen-integrate --apply || true
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  udevadm control --reload || true
  systemctl daemon-reload || true
  systemctl try-restart fprintd.service || true
}
