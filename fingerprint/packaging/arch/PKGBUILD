pkgname=libfprint-goodix51a0
pkgver=1.94.100.goodix51a0
pkgrel=55
pkgdesc="libfprint 1.94.100 with experimental Goodix GXFP51A0 SPI driver"
arch=('x86_64')
url="https://fprint.freedesktop.org/"
install=libfprint-goodix51a0.install
license=('LGPL-2.1-or-later')
depends=('bash' 'glib2' 'glibc' 'libgcc' 'libgudev' 'libgusb' 'openssl' 'pixman' 'kmod' 'systemd')
makedepends=('git' 'python' 'pkgconf' 'cairo')
provides=('libfprint=1.94.100' 'libfprint-2.so')
conflicts=('libfprint')
options=('!debug')

_fp_root="$(cd "$startdir/../.." && pwd)"

build() {
  local build_root="$srcdir/gxfp51a0-public-build"

  GXFP51A0_BUILD_ROOT="$build_root" \
  GXFP51A0_MESON_PREFIX=/usr \
    "$_fp_root/scripts/build-libfprint-v1.94.100.sh"
}

package() {
  local build_root="$srcdir/gxfp51a0-public-build"

  export PATH="$build_root/build-tools-venv/bin:$PATH"
  DESTDIR="$pkgdir" meson install -C "$build_root/libfprint-build"

  install -Dm644 "$startdir/fprintd-goodix51a0.conf" \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/50-goodix51a0-runtime.conf"

  install -Dm755 "$_fp_root/integration/boot-prewarm/gxfp51a0-boot-prewarm" \
    "$pkgdir/usr/libexec/gxfp51a0-boot-prewarm"
  install -Dm644 "$_fp_root/integration/boot-prewarm/gxfp51a0-boot-prewarm.service" \
    "$pkgdir/usr/lib/systemd/system/gxfp51a0-boot-prewarm.service"

  install -Dm755 "$_fp_root/integration/kde-lockscreen/gxfp51a0-kde-lockscreen-integrate" \
    "$pkgdir/usr/libexec/gxfp51a0-kde-lockscreen-integrate"
  install -Dm644 "$_fp_root/integration/kde-lockscreen/90-gxfp51a0-kde-lockscreen.hook" \
    "$pkgdir/usr/share/libalpm/hooks/90-gxfp51a0-kde-lockscreen.hook"

  # fprintd is available before the greeter, but libfprint probe() remains
  # passive. Prewarm the reader once before the display manager before the first finger. Deep-resume recovery is driver-native: an active
  # authentication detects CLOCK_BOOTTIME-vs-MONOTONIC sleep advancement and
  # rebuilds TLS/background/FDT without any systemd/D-Bus helper.
  # The production driver deliberately has no periodic synthetic Claim: real Claims refresh the
  # no-finger background/FDT baseline and warm validation handles staleness.
  install -d "$pkgdir/usr/lib/systemd/system/graphical.target.wants"
  ln -s ../fprintd.service \
    "$pkgdir/usr/lib/systemd/system/graphical.target.wants/fprintd.service"
  ln -s ../gxfp51a0-boot-prewarm.service \
    "$pkgdir/usr/lib/systemd/system/graphical.target.wants/gxfp51a0-boot-prewarm.service"

  if [[ -f "$build_root/libfprint-v1.94.100/COPYING" ]]; then
    install -Dm644 "$build_root/libfprint-v1.94.100/COPYING" \
      "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  fi
}
