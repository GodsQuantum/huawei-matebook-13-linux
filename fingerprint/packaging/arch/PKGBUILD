pkgname=libfprint-goodix51a0
pkgver=1.94.100.goodix51a0
pkgrel=30
pkgdesc="libfprint 1.94.100 with experimental Goodix GXFP51A0 SPI driver"
arch=('x86_64')
url="https://fprint.freedesktop.org/"
install=libfprint-goodix51a0.install
license=('LGPL-2.1-or-later')
depends=('bash' 'glib2' 'glibc' 'libgcc' 'libgudev' 'libgusb' 'openssl' 'pixman' 'kmod' 'systemd')
makedepends=('git' 'python' 'pkgconf' 'cairo')
provides=('libfprint=1.94.100' 'libfprint-2.so')
conflicts=('libfprint')
options=('!debug')

_fp_root="$(cd "$startdir/../.." && pwd)"

build() {
  local build_root="$srcdir/gxfp51a0-public-build"

  GXFP51A0_BUILD_ROOT="$build_root" \
  GXFP51A0_MESON_PREFIX=/usr \
    "$_fp_root/scripts/build-libfprint-v1.94.100.sh"
}

package() {
  local build_root="$srcdir/gxfp51a0-public-build"

  export PATH="$build_root/build-tools-venv/bin:$PATH"
  DESTDIR="$pkgdir" meson install -C "$build_root/libfprint-build"

  install -Dm644 "$startdir/fprintd-goodix51a0.conf" \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/50-goodix51a0-runtime.conf"

  install -Dm755 "$_fp_root/integration/resume-prewarm/gxfp51a0-resume-prewarm" \
    "$pkgdir/usr/libexec/gxfp51a0-resume-prewarm"
  install -Dm644 "$_fp_root/integration/resume-prewarm/gxfp51a0-resume-prewarm.service" \
    "$pkgdir/usr/lib/systemd/system/gxfp51a0-resume-prewarm.service"
  install -Dm644 "$_fp_root/integration/resume-prewarm/gxfp51a0-resume-prewarm-worker.service" \
    "$pkgdir/usr/lib/systemd/system/gxfp51a0-resume-prewarm-worker.service"

  install -Dm755 "$_fp_root/integration/warm-keepalive/gxfp51a0-warm-keepalive" \
    "$pkgdir/usr/libexec/gxfp51a0-warm-keepalive"
  install -Dm644 "$_fp_root/integration/warm-keepalive/gxfp51a0-warm-keepalive.service" \
    "$pkgdir/usr/lib/systemd/system/gxfp51a0-warm-keepalive.service"
  install -Dm644 "$_fp_root/integration/warm-keepalive/gxfp51a0-warm-keepalive.timer" \
    "$pkgdir/usr/lib/systemd/system/gxfp51a0-warm-keepalive.timer"

  install -Dm755 "$_fp_root/integration/kde-lockscreen/gxfp51a0-kde-lockscreen-integrate" \
    "$pkgdir/usr/libexec/gxfp51a0-kde-lockscreen-integrate"
  install -Dm644 "$_fp_root/integration/kde-lockscreen/90-gxfp51a0-kde-lockscreen.hook" \
    "$pkgdir/usr/share/libalpm/hooks/90-gxfp51a0-kde-lockscreen.hook"

  # fprintd is available before the greeter, but libfprint probe() remains
  # passive. A package-owned sleep.target helper briefly Claims the reader
  # after resume so the normal open/close lifecycle rebuilds background/FDT
  # before a lock-screen finger can contaminate calibration.
  install -d "$pkgdir/usr/lib/systemd/system/graphical.target.wants"
  ln -s ../fprintd.service \
    "$pkgdir/usr/lib/systemd/system/graphical.target.wants/fprintd.service"
  install -d "$pkgdir/usr/lib/systemd/system/sleep.target.wants"
  ln -s ../gxfp51a0-resume-prewarm.service \
    "$pkgdir/usr/lib/systemd/system/sleep.target.wants/gxfp51a0-resume-prewarm.service"
  install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../gxfp51a0-warm-keepalive.timer \
    "$pkgdir/usr/lib/systemd/system/timers.target.wants/gxfp51a0-warm-keepalive.timer"

  if [[ -f "$build_root/libfprint-v1.94.100/COPYING" ]]; then
    install -Dm644 "$build_root/libfprint-v1.94.100/COPYING" \
      "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  fi
}
