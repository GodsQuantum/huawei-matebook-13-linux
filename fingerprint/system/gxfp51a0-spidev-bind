#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob

readonly ACPI_PREFIX='acpi:GXFP51A0:'
readonly SPI_ROOT='/sys/bus/spi/devices'
readonly SPI_DRIVER_ROOT='/sys/bus/spi/drivers/spidev'

log() { printf 'gxfp51a0-spidev-bind: %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

find_sensor() {
    local modalias
    for modalias in "$SPI_ROOT"/*/modalias; do
        [[ -r "$modalias" ]] || continue
        [[ "$(<"$modalias")" == "$ACPI_PREFIX"* ]] || continue
        dirname "$modalias"
    done
}

sensor=''
for _ in {1..50}; do
    mapfile -t sensors < <(find_sensor)
    if ((${#sensors[@]} == 1)); then
        sensor="${sensors[0]}"
        break
    fi
    ((${#sensors[@]} > 1)) && die "expected one GXFP51A0 SPI device, found ${#sensors[@]}"
    sleep 0.04
done
[[ -n "$sensor" ]] || die "GXFP51A0 SPI device did not appear within 2 seconds"

device="$(basename "$sensor")"
driver=''
[[ -L "$sensor/driver" ]] && driver="$(basename "$(readlink -f "$sensor/driver")")"

if [[ -n "$driver" && "$driver" != spidev ]]; then
    die "$device is already owned by unexpected driver '$driver'; refusing to unbind it"
fi

modprobe spidev

if [[ "$driver" != spidev ]]; then
    [[ -w "$sensor/driver_override" ]] || die "$sensor/driver_override is not writable"
    printf '%s\n' spidev > "$sensor/driver_override"
    [[ -e "$SPI_DRIVER_ROOT/bind" ]] || die "spidev bind interface is unavailable after modprobe"
    printf '%s\n' "$device" > "$SPI_DRIVER_ROOT/bind"
fi

udevadm settle --timeout=2 || true

real_sensor="$(readlink -f "$sensor")"
node=''
for _ in {1..50}; do
    for child in "$real_sensor"/spidev/spidev*; do
        [[ -d "$child" ]] || continue
        candidate="/dev/$(basename "$child")"
        if [[ -c "$candidate" ]]; then
            node="$candidate"
            break 2
        fi
    done
    sleep 0.04
done

[[ -n "$node" ]] || die "spidev bound to $device but no character device appeared within 2 seconds"

driver="$(basename "$(readlink -f "$sensor/driver")")"
[[ "$driver" == spidev ]] || die "post-bind driver verification failed: ${driver:-none}"

log "$device -> spidev ($node)"
