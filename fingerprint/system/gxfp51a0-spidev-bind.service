[Unit]
Description=Prepare Goodix GXFP51A0 SPI transport for fprintd
Documentation=https://github.com/GodsQuantum/huawei-matebook-13-linux/tree/main/fingerprint
After=systemd-udev-trigger.service
Before=fprintd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/gxfp51a0-spidev-bind
TimeoutStartSec=5s
